{
  "manifest_version": 3,
  "name": "YouTube Timestamp Bookmark",
  "description": "Bookmark YouTube videos with timestamps.",
  "version": "1.0.0",
  "action": {
    "default_icon": "icon.png",
    "default_title": "Bookmark"
  },
  "permissions": ["activeTab", "scripting", "bookmarks"],
  "background": {
    "service_worker": "background.js"
  }
}
